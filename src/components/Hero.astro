---
import { Image } from "astro:assets";

const { config } = Astro.props;
---

<section
    id="Hero"
    class="w-full min-h-[calc(100vh-4rem)] lg:min-h-0 lg:h-[calc(100vh-4rem)] lg:max-h-[950px] h-auto py-8 sm:py-12 lg:py-4 bg-background flex justify-center lg:justify-around items-center flex-col-reverse lg:flex-row gap-8 lg:gap-0 overflow-hidden"
>
    <!-- Hero Intro Info -->
    <div class="w-full lg:w-fit flex justify-start items-center flex-col gap-5 sm:gap-6 px-2 lg:px-0">
        <div class="text-[15px] xs:text-[16px] sm:text-[18px] lg:text-[20px] text-center lg:text-left">
            <p class="Fade_Stagger">{config.salutation}</p>
            <h1
                class="Fade_Stagger gradientText font-ubuntu text-[2.5rem] xs:text-[3rem] sm:text-[4.2rem] lg:text-[6rem] leading-tight max-w-full lg:max-w-6xl"
            >
                {config.firstName}
                {config.lastName ? " " + config.lastName : ""}
            </h1>
            <p class="Fade_Stagger">I'm a {config.position}.</p>
            <p class="Fade_Stagger">
                {config.tagLine.prefixText}
                <span class="gradientText font-ubuntu">
                    {config.tagLine.highlightedText}
                </span>
                {config.tagLine.suffixText}
            </p>
        </div>

        <div
            class="Fade_Stagger flex justify-center lg:justify-start items-center w-full gap-5 sm:gap-7 py-2 text-socialIconColor!"
        >
            {
                config.links &&
                    config.links.map(
                        (link: {
                            label: string;
                            url: string;
                            icon: string;
                        }) => (
                            <a
                                href={link.url}
                                title={link.label}
                                aria-label={link.label}
                                target="_blank"
                                rel="noreferrer"
                                class="Fade_Stagger w-[26px] h-[26px] flex items-center justify-center"
                            >
                                <Fragment set:html={link.icon} />
                            </a>
                        ),
                    )
            }
        </div>
    </div>

    <!-- Hero Orbit Animation -->
    <div
        class="Hero_Orbit relative flex_center w-[220px] xs:w-[260px] sm:w-[320px] lg:w-[380px] aspect-square"
    >
        <div
            id="avatarImage"
            role="button"
            class="flex_center w-[120px] xs:w-[140px] sm:w-[170px] lg:w-[200px] aspect-square rounded-full z-10 cursor-pointer overflow-hidden shadow-2xl border border-white/10"
            style={{ opacity: 0 }}
        >
            <Image
                src={config.avatar}
                alt={`${config.firstName} Avatar`}
                class="object-cover w-full h-full rounded-full noDrag"
                width="200"
                height="200"
                priority
            />
        </div>

        <!-- Orbit Trails -->
        <div class="Spring_Up Hero_Trail Trail1">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail2">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail3">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail4">
            <span class="Orbit_Dot"></span>
        </div>
    </div>
</section>
