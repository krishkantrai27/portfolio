---
import { Image } from "astro:assets";
import { Avatar_250 } from "@assets/images";
import { SectionTitle } from "@components/UI";

const { config } = Astro.props;
---

<section id="about" class="w-full min-h-fit py-8 pt-16 lg:py-12 lg:pt-20 bg-background">
    <SectionTitle
        title="About Me"
        color="primary"
        className="flex flex-col justify-center py-4 lg:py-8"
    >
        <div class="flex items-center lg:justify-center flex-col lg:flex-row w-full lg:h-full py-6 lg:py-10 gap-6 lg:gap-8">
            <Image
                src={Avatar_250}
                alt="About_Avatar"
                class="Fade_Up rounded-full object-cover size-[170px] xs:size-[190px] sm:size-[220px] lg:size-[250px] lg:mx-14 shadow-2xl border-2 border-white/10 shrink-0"
                width={250}
                height={250}
                loading="lazy"
                decoding="async"
            />

            <div
                class="Fade_Up w-full md:w-[80%] lg:w-[60%] flex justify-center items-start flex-col gap-4 lg:border-l border-primary py-4 lg:py-8 lg:pl-10"
            >
                <h2 class="Fade_Up text-[1.35em] sm:text-[1.5em] font-bold">Hey there! 👋🏻</h2>
                {
                    config.description &&
                        config.description.map((para: string) => (
                            <p class="Fade_Up text-justify text-sm sm:text-base leading-relaxed">{para}</p>
                        ))
                }
            </div>
        </div>
    </SectionTitle>
</section>
